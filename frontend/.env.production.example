# Copy to .env.production and fill in BEFORE running `npm run build`.
# NEXT_PUBLIC_* values are compiled into the JavaScript, so changing them means rebuilding.

# Public HTTPS address of the API. A phone cannot reach "localhost", and an https site cannot call an http API
# (browsers block mixed content).
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Leave unset in production. Set to "true" only for a deliberate public demo (shows the demo-login panel on /login).
# NEXT_PUBLIC_DEMO_LOGIN=true
# NEXT_PUBLIC_DEMO_PASSWORD=
